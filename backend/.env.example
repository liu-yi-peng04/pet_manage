# 复制为 backend/.env 后按需修改。本文件不含真实密钥。
# 本地演示闭环：
APP_ENV=demo
# DEMO_MODE=true 等价于打开演示模式，即使 APP_ENV=production
DEMO_MODE=false
# 演示模式才会在启动时安全建表。生产环境忽略此项，必须 aerich upgrade。
DEMO_AUTO_SCHEMA=true

# 生产环境必填，至少 32 位，且不能是占位符。演示模式可留空。
SECRET_KEY=
# 生产环境必填，且不能是 root/123456 演示串。演示模式留空则使用本机 127.0.0.1 演示库。
DATABASE_URL=mysql://root:123456@127.0.0.1:3306/ai_kb

# 逗号分隔，禁止 *
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

SUPER_ADMIN_USERNAME=admin
# 仅生产环境且库中还没有超管时使用。不要用 admin123 / Passw0rd!a
SUPER_ADMIN_PASSWORD=
# 仅演示模式。留空则使用文档中的演示口令。
DEMO_PASSWORD=
DEMO_ADMIN_PASSWORD=

# 对话功能需要。不配置不影响登录和媒体。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# db | filesystem | s3（s3 当前会拒绝启动）
MEDIA_STORAGE=db
MEDIA_FS_ROOT=uploads/media
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
